{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokendial.app/schemas/provider.json",
  "title": "Tokendial provider spec",
  "description": "How Tokendial reads one assistant's usage: where the credential lives on each OS, which endpoint answers, and how its response maps onto limit windows. Both cores implement exactly what is written here.",
  "type": "object",
  "required": ["id", "displayName", "fidelity", "credential", "endpoints", "response", "polling", "status"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "displayName": { "type": "string" },
    "fidelity": { "enum": ["official", "derived"] },
    "headline": { "type": "string", "description": "Window id the dial shows. Absent means the first window in the response." },
    "credential": {
      "type": "object",
      "required": ["macos", "windows"],
      "properties": {
        "macos": { "$ref": "#/$defs/credential" },
        "windows": { "$ref": "#/$defs/credential" },
        "linux": { "$ref": "#/$defs/credential" }
      },
      "additionalProperties": false
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "method", "url"],
        "properties": {
          "name": { "type": "string" },
          "method": { "enum": ["GET", "POST"] },
          "url": { "type": "string", "format": "uri-template" },
          "headers": { "type": "object", "additionalProperties": { "type": "string" } },
          "body": { "type": "string" },
          "timeoutSeconds": { "type": "integer", "default": 15 },
          "notes": { "type": "string" }
        }
      }
    },
    "response": {
      "type": "object",
      "required": ["windows"],
      "properties": {
        "envelopeErrors": { "type": "string", "description": "How errors ride inside a 200 body, if they do." },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "usedPath": { "type": "string", "description": "JSON path to the used fraction or percent." },
              "unit": { "enum": ["fraction", "percent", "percentRemaining", "remainingFraction", "usedOverLimit", "count"] },
              "resetAtPath": { "type": "string" },
              "resetUnit": { "enum": ["iso8601", "dateUtc", "epochSeconds", "epochMillis", "afterSeconds"] },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "errors": {
      "type": "object",
      "description": "HTTP status → Tokendial status.",
      "additionalProperties": { "enum": ["needsAuth", "credentialExpired", "rateLimited", "nothingMetered", "badResponse", "ignore"] }
    },
    "polling": {
      "type": "object",
      "required": ["activeSeconds", "idleSeconds", "staleSeconds", "backoff"],
      "properties": {
        "activeSeconds": { "type": "integer" },
        "idleSeconds": { "type": "integer" },
        "staleSeconds": { "type": "integer" },
        "backoff": { "enum": ["exponential", "flat60", "none"] }
      }
    },
    "sessions": {
      "type": "object",
      "description": "Where live sessions come from, if the tool exposes them.",
      "properties": {
        "kind": { "enum": ["registry", "sqlite", "mtime", "none"] },
        "macos": { "type": "string" },
        "windows": { "type": "string" },
        "linux": { "type": "string" },
        "staleSeconds": { "type": "integer" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "install": { "$ref": "#/$defs/install" },
    "status": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAppVersion": { "type": "string" },
        "notice": { "type": "string" },
        "termsRisk": { "enum": ["low", "medium", "high"] },
        "platforms": {
          "type": "object",
          "description": "Where a usage reading works. Absent means everywhere. A platform set to false is declared unsupported rather than left to fail as needsAuth, which would tell a signed-in user to sign in again.",
          "properties": {
            "windows": { "type": "boolean" },
            "macos": { "type": "boolean" },
            "linux": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "install": {
      "type": "object",
      "description": "How the assistant installs the tool that owns the credential and signs it in, per OS. Commands are the vendor's own; the app shows them before running them in a visible terminal and never fetches them from the network.",
      "required": ["vendor", "docsUrl", "windows", "macos"],
      "additionalProperties": false,
      "properties": {
        "vendor": { "type": "string" },
        "docsUrl": { "type": "string", "format": "uri" },
        "windows": { "$ref": "#/$defs/installPlatform" },
        "macos": { "$ref": "#/$defs/installPlatform" },
        "linux": { "$ref": "#/$defs/installPlatform" }
      }
    },
    "installPlatform": {
      "type": "object",
      "required": ["kind", "detect", "install"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["cli", "app"], "description": "cli: the terminal chains the sign-in command after installing. app: signing in means opening the desktop app." },
        "detect": {
          "type": "object",
          "properties": {
            "commands": { "type": "array", "items": { "type": "string" }, "description": "Executable names looked up on PATH, including the process, user and machine PATH." },
            "paths": { "type": "array", "items": { "type": "string" }, "description": "Absolute locations with ~, %VAR% and one * per segment allowed." }
          }
        },
        "requires": { "type": "array", "items": { "enum": ["winget", "brew", "npm", "apt", "snap", "flatpak"] }, "description": "Package managers the line needs. The assistant offers to install a missing one as a first step before the tool." },
        "install": { "type": "string", "description": "The exact shell line, PowerShell on Windows and zsh on macOS." },
        "signIn": {
          "type": "object",
          "required": ["command", "hint"],
          "properties": {
            "command": { "type": "string" },
            "hint": { "type": "string", "description": "Catalogue key of the sentence shown before the command runs." }
          }
        },
        "downloadUrl": { "type": "string", "format": "uri" }
      }
    },
    "credential": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["file", "sqlite", "keychain", "credman", "secret-service", "none"] },
        "path": { "type": "string", "description": "With ~ for the home directory and %VAR% for Windows environment variables." },
        "service": { "type": "string" },
        "account": { "type": "string" },
        "target": { "type": "string" },
        "query": { "type": "string" },
        "fields": { "type": "object", "additionalProperties": { "type": "string" } },
        "expiry": { "type": "string", "description": "Where the expiry lives and its unit." },
        "notes": { "type": "string" }
      }
    }
  }
}
