<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Tokendial</AssemblyName>
    <RootNamespace>Tokendial.Linux</RootNamespace>
    <Product>Tokendial</Product>
    <Company>Raybel Hernández</Company>
    <Copyright>© Raybel Hernández. MIT License.</Copyright>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <!-- Not for the look: every built-in control gets its template from the theme, and without one a
         ScrollViewer reports a zero extent and never scrolls. Tokendial's own controls carry their own. -->
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <!-- Already in the bundle: Avalonia.X11 speaks D-Bus for the tray. Named explicitly because the
         notification sink depends on it directly, and an implicit transitive version is not a contract. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../windows/Tokendial.Core/Tokendial.Core.csproj" />
  </ItemGroup>

  <!-- The same two resources under the same logical names the Windows app uses, so Marks.Load ports unchanged. -->
  <ItemGroup>
    <EmbeddedResource Include="../../docs/design/marks/normalized/marks.json" LogicalName="marks.json" />
    <EmbeddedResource Include="../../docs/design/marks/normalized/opencode.png" LogicalName="opencode.png" />
  </ItemGroup>

  <!-- The application icon, written into the icon theme when Tokendial is added to the menu. Carried here in
       the two sizes a menu and a HiDPI menu ask for, the way Windows carries its .ico and macOS its catalogue. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/tokendial-256.png" LogicalName="tokendial-256.png" />
    <EmbeddedResource Include="Assets/tokendial-512.png" LogicalName="tokendial-512.png" />
  </ItemGroup>

</Project>
