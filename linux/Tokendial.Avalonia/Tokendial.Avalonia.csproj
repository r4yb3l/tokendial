<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Tokendial</AssemblyName>
    <RootNamespace>Tokendial.Linux</RootNamespace>
    <Product>Tokendial</Product>
    <Company>Raybel Hernández</Company>
    <Copyright>© Raybel Hernández. MIT License.</Copyright>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../windows/Tokendial.Core/Tokendial.Core.csproj" />
  </ItemGroup>

  <!-- The same two resources under the same logical names the Windows app uses, so Marks.Load ports unchanged. -->
  <ItemGroup>
    <EmbeddedResource Include="../../docs/design/marks/normalized/marks.json" LogicalName="marks.json" />
    <EmbeddedResource Include="../../docs/design/marks/normalized/opencode.png" LogicalName="opencode.png" />
  </ItemGroup>

</Project>
