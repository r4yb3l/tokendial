---
import { Image } from 'astro:assets';
import Mark from './Mark.astro';
import { blogPath, readingMinutes, slugOf, type Post } from '../blog';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  post: Post;
  locale: Locale;
  compact?: boolean;
}
const { post, locale, compact = false } = Astro.props;
const t = useTranslations(locale);
const date = post.data.date.toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const provider = post.data.provider as Parameters<typeof Mark>[0]['id'] | undefined;
---

<a href={blogPath(locale, slugOf(post))} class:list={['card group flex flex-col gap-3 overflow-hidden transition-colors hover:border-brand-500/40', compact ? 'p-5' : 'p-6']}>
  {post.data.cover && !compact && (
    <Image src={post.data.cover} alt={post.data.coverAlt ?? ''} width={720} height={405} class="-mx-6 -mt-6 mb-1 aspect-video w-[calc(100%+3rem)] max-w-none object-cover" loading="lazy" decoding="async" />
  )}
  <div class="flex items-center gap-2 text-xs text-slate-400">
    <span class="eyebrow !py-0.5">{t(`blog.section.${post.data.section}`)}</span>
    {provider && <span class="grid size-6 place-items-center rounded-md bg-ink-800 text-slate-300"><Mark id={provider} size={12} /></span>}
    <span class="ms-auto">{date}</span>
  </div>
  <h3 class:list={['font-semibold text-slate-100 group-hover:text-brand-400 transition-colors', compact ? 'text-base' : 'text-lg']}>{post.data.title}</h3>
  <p class="text-sm leading-relaxed text-slate-400">{post.data.description}</p>
  <span class="mt-auto text-xs text-slate-500">{t('blog.minutes', { n: readingMinutes(post.body) })}</span>
</a>
