---
import Hero from './Hero.astro';
import Section from './Section.astro';
import Mark from './Mark.astro';
import Dial from './Dial.astro';
import { list, useTranslations, locales, type Locale } from '../i18n';
import { links } from '../data/links';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const providers = ['claude', 'codex', 'copilot', 'cursor', 'antigravity', 'gemini', 'glm', 'grok', 'opencode'] as const;
const tints: Record<(typeof providers)[number], string> = {
  claude: '#d97757', codex: '#38bdf8', copilot: '#a78bfa', cursor: '#e2e8f0',
  antigravity: '#60a5fa', gemini: '#4e8df5', glm: '#3b82f6', grok: '#f1f5f9', opencode: '#fbbf24'
};
const steps = list(locale, 'how');
const alerts = list(locale, 'alerts');
const alertTones = ['text-brand-400', 'text-watch', 'text-brand-400', 'text-critical'];
const alertIcons = [
  'M12 3v18M5 12h14',
  'M12 8v4l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
  'M15 17h5l-1.4-1.4A2 2 0 0 1 18 14.2V11a6 6 0 0 0-4-5.7V5a2 2 0 1 0-4 0v.3C7.7 6.2 6 8.4 6 11v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0v1a3 3 0 1 1-6 0v-1',
  'M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z'
];
const edges = [
  { key: 'top', lit: true, bar: 'inset-x-1.5 top-1.5 h-1.5' },
  { key: 'bottom', lit: false, bar: 'inset-x-1.5 bottom-1.5 h-1.5' },
  { key: 'left', lit: false, bar: 'inset-y-1.5 left-1.5 w-1.5' },
  { key: 'right', lit: false, bar: 'inset-y-1.5 right-1.5 w-1.5' }
];
const securityPoints = [t('security.1'), t('security.2'), t('security.3'), t('security.4')];
const installPoints = [t('install.1'), t('install.2'), t('install.3')];
const languageNames: Record<string, string> = {
  en: 'English', 'en-GB': 'English (UK)', es: 'Español', fr: 'Français', de: 'Deutsch', ar: 'العربية'
};
---

<Hero locale={locale} />

<Section id="how" eyebrow={t('how.eyebrow')} title={t('how.title')} lead={t('why.lead')}>
  <ol class="grid gap-4 md:grid-cols-3">
    {steps.map((step, i) => (
      <li class="card reveal p-6" style={`transition-delay:${i * 60}ms`}>
        <span class="inline-grid size-10 place-items-center rounded-xl border border-ink-700/60 bg-ink-800 font-mono text-sm font-semibold text-brand-400">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-5 text-lg font-semibold text-slate-100">{step.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-400">{step.body}</p>
      </li>
    ))}
  </ol>

  <div class="card reveal mt-4 p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">{t('providers.title')}</p>
    <ul class="mt-4 grid gap-2.5 sm:grid-cols-3 lg:grid-cols-5" role="list">
      {providers.map((id) => (
        <li class="flex min-w-0 items-center gap-2.5 rounded-xl border border-ink-700/60 bg-ink-800 px-3 py-2.5">
          <span class="grid size-6 shrink-0 place-items-center rounded-lg" style={`color:${tints[id]};background:${tints[id]}29`}>
            <Mark id={id} size={13} />
          </span>
          <span class="truncate text-xs font-medium text-slate-200">{t(`providers.${id}`)}</span>
        </li>
      ))}
    </ul>
  </div>
</Section>

<Section id="alerts" eyebrow={t('alerts.eyebrow')} title={t('alerts.title')} lead={t('alerts.lead')}>
  <ul class="grid gap-4 sm:grid-cols-2" role="list">
    {alerts.map((alert, i) => (
      <li class="card reveal flex gap-4 p-6" style={`transition-delay:${i * 60}ms`}>
        <span class:list={['grid size-10 shrink-0 place-items-center rounded-xl border border-ink-700/60 bg-ink-800', alertTones[i]]}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={alertIcons[i]} /></svg>
        </span>
        <div>
          <h3 class="font-semibold text-slate-100">{alert.title}</h3>
          <p class="mt-1 text-sm leading-relaxed text-slate-400">{alert.body}</p>
        </div>
      </li>
    ))}
  </ul>
</Section>

<Section id="dock" eyebrow={t('dock.eyebrow')} title={t('dock.title')}>
  <div class="grid items-start gap-4 lg:grid-cols-2">
    <div class="card reveal divide-y divide-ink-700/50">
      <div class="p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">{t('dock.1.title')}</p>
        <ul class="mt-4 grid grid-cols-4 gap-3" role="list">
          {edges.map((edge) => (
            <li>
              <span class:list={['ltr theme-dark relative block h-20 rounded-lg border bg-ink-950', edge.lit ? 'border-brand-500/40' : 'border-ink-700/60']}>
                <span class:list={['absolute rounded-sm', edge.bar, edge.lit ? 'bg-brand-500' : 'bg-ink-600']} aria-hidden="true"></span>
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div class="p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">{t('dock.2.title')}</p>
        <ul class="mt-4 grid grid-cols-2 gap-3" role="list">
          <li>
            <span class="ltr theme-dark grid h-24 justify-center overflow-hidden rounded-lg border border-ink-700/60 bg-ink-950">
              <span class="flex h-fit items-center gap-3 rounded-b-xl border border-t-0 border-ink-600/60 bg-ink-900 px-4 py-2.5">
                <Dial size={22} stroke={3} fraction={0.41} animate={false} />
                <Dial size={22} stroke={3} fraction={0.63} color="#fbbf24" animate={false} />
                <Dial size={22} stroke={3} fraction={0.87} color="#fb7185" animate={false} />
              </span>
            </span>
            <span class="mt-2 block text-center text-xs text-slate-400">{t('theme.dark')}</span>
          </li>
          <li>
            <span class="ltr grid h-24 justify-center overflow-hidden rounded-lg border border-ink-700/60 bg-[#e9edf3]">
              <span class="flex h-fit items-center gap-3 rounded-b-xl border border-t-0 border-[#c5ceda] bg-white px-4 py-2.5">
                <Dial size={22} stroke={3} fraction={0.41} color="#059669" track="rgb(15 23 42 / 0.14)" animate={false} />
                <Dial size={22} stroke={3} fraction={0.63} color="#d97706" track="rgb(15 23 42 / 0.14)" animate={false} />
                <Dial size={22} stroke={3} fraction={0.87} color="#e11d48" track="rgb(15 23 42 / 0.14)" animate={false} />
              </span>
            </span>
            <span class="mt-2 block text-center text-xs text-slate-400">{t('theme.light')}</span>
          </li>
        </ul>
      </div>
      <div class="p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">{t('dock.3.title')}</p>
        <ul class="mt-4 flex flex-wrap gap-2" role="list">
          {locales.map((code) => (
            <li class:list={['rounded-lg border px-2.5 py-1.5 text-xs', code === locale ? 'border-brand-500/40 bg-brand-500/10 font-medium text-slate-100' : 'border-ink-700/60 bg-ink-800 text-slate-400']}>
              {languageNames[code] ?? code}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="card reveal divide-y divide-ink-700/50">
      <div class="p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">{t('install.eyebrow')}</p>
        <h3 class="mt-3 text-lg font-semibold text-slate-100">{t('install.title')}</h3>
        <div class="mt-4 flex items-center gap-4 rounded-xl border border-ink-700/60 bg-ink-800 p-4">
          <span class="grid size-9 shrink-0 place-items-center rounded-lg border border-ink-700 bg-ink-750 text-slate-300"><Mark id="grok" size={16} /></span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-slate-100">{t('providers.grok')}</p>
            <ol class="mt-1.5 flex items-center gap-2 text-[11px] text-slate-500" aria-label={t('install.eyebrow')}>
              {[t('install.step.install'), t('install.step.signin'), t('install.step.ready')].map((step, i) => (
                <>
                  {i > 0 && <span class="h-px w-4 bg-ink-600" aria-hidden="true"></span>}
                  <li class="flex items-center gap-1.5">
                    <span class:list={['size-2 rounded-full border', i === 0 ? 'border-brand-500 bg-brand-500' : 'border-slate-500']} aria-hidden="true"></span>
                    {step}
                  </li>
                </>
              ))}
            </ol>
          </div>
          <span class="btn-primary pointer-events-none !min-h-9 !px-3.5 text-xs" aria-hidden="true">{t('install.step.install')}</span>
        </div>
      </div>
      <div class="p-6">
        <div class="ltr theme-dark overflow-hidden rounded-xl border border-ink-700/60 bg-ink-950 font-mono text-[12px] leading-relaxed">
          <div class="flex items-center gap-1.5 border-b border-ink-700/60 px-4 py-2.5 text-[11px] text-slate-500">
            <span class="size-2.5 rounded-full bg-ink-600"></span><span class="size-2.5 rounded-full bg-ink-600"></span><span class="size-2.5 rounded-full bg-ink-600"></span>
            <span class="ms-2">Tokendial · Grok</span>
          </div>
          <pre class="overflow-x-auto whitespace-pre p-4 text-slate-400"><span class="text-slate-500">Installer from xAI · https://docs.x.ai/build/cli/reference</span>
<span class="text-watch">&gt; irm https://x.ai/cli/install.ps1 | iex</span>
<span class="text-brand-400">Installed.</span>
<span class="text-slate-500">Grok opens the browser to sign in with your xAI account.</span>
<span class="text-watch">&gt; grok login</span>
<span class="text-brand-400">Done. You can close this window.</span></pre>
        </div>
        <ul class="mt-4 space-y-2" role="list">
          {installPoints.map((point) => (
            <li class="flex gap-2.5 text-sm leading-relaxed text-slate-400">
              <svg class="mt-1 shrink-0 text-brand-400" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4L19 7" /></svg>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</Section>

<section id="download" class="scroll-mt-20 py-12 md:py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="card reveal relative overflow-hidden p-10 text-center md:p-14">
      <div class="absolute inset-0 bg-[radial-gradient(40rem_16rem_at_50%_120%,rgb(16_185_129/0.18),transparent_60%)]" aria-hidden="true"></div>
      <div class="relative">
        <Dial size={44} stroke={4} fraction={0.73} class="mx-auto" />
        <h2 class="mt-6 text-3xl font-semibold tracking-tight text-slate-100 md:text-4xl">{t('cta.title')}</h2>
        <p class="mx-auto mt-4 max-w-xl text-lg text-slate-400">{t('cta.lead')}</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3" data-downloads>
          <a href={links.releases} class="btn-download" data-download="windows" rel="noopener">{t('hero.windows')}</a>
          <a href={links.releases} class="btn-download" data-download="mac" rel="noopener">{t('hero.macos')}</a>
          <a href={links.releases} class="btn-download" data-download="linux" rel="noopener">{t('hero.linux')}</a>
          <a href={links.repo} class="btn-secondary" rel="noopener">{t('hero.source')}</a>
        </div>
        <p class="mt-4 text-xs text-slate-500">{t('hero.note')}</p>
      </div>
    </div>

    <div class="card reveal mt-4 p-6">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h3 class="font-semibold text-slate-100">{t('security.title')}</h3>
        <a href={links.security} class="text-sm font-medium text-brand-400 hover:text-brand-400/80" rel="noopener">{t('security.link')} &rarr;</a>
      </div>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2" role="list">
        {securityPoints.map((point) => (
          <li class="flex gap-2.5">
            <svg class="mt-0.5 shrink-0 text-brand-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.4 8.6 8 9.9 4.6-1.3 8-4.9 8-9.9V6z" /><path d="m9 12 2 2 4-4" /></svg>
            <p class="text-sm leading-relaxed text-slate-400">{point}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="card reveal mt-4 p-6">
      <h3 class="font-semibold text-slate-100">{t('unsigned.title')}</h3>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-slate-400">{t('unsigned.lead')}</p>
      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Windows</h4>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{t('unsigned.windows')}</p>
        </div>
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500">macOS</h4>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{t('unsigned.macos')}</p>
          <p class="ltr mt-2 overflow-x-auto rounded-lg border border-ink-700/60 bg-ink-950 px-3 py-2 font-mono text-[12px] leading-relaxed text-slate-300">xattr -dr com.apple.quarantine /Applications/Tokendial.app</p>
        </div>
      </div>
    </div>
  </div>
</section>
