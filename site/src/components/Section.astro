---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  lead?: string;
  class?: string;
}
const { id, eyebrow, title, lead, class: className = '' } = Astro.props;
---

<section id={id} class:list={['scroll-mt-20 py-12 md:py-16', className]}>
  <div class="mx-auto max-w-6xl px-5">
    <div class="reveal max-w-2xl">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight text-slate-100 md:text-4xl">{title}</h2>
      {lead && <p class="mt-4 text-lg leading-relaxed text-slate-400">{lead}</p>}
    </div>
    <div class="mt-8 md:mt-10">
      <slot />
    </div>
  </div>
</section>
