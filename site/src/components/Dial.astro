---
/** A 240° gauge like the app's: the arc opens at the bottom, fills clockwise, and animates in when it scrolls into view. */
interface Props {
  size: number;
  stroke: number;
  fraction: number;
  color?: string;
  track?: string;
  class?: string;
  animate?: boolean;
}
const { size, stroke, fraction, color = '#34d399', track = 'rgb(255 255 255 / 0.16)', class: className = '', animate = true } = Astro.props;
const c = size / 2;
const r = c - stroke / 2;
const rad = (deg: number) => (deg * Math.PI) / 180;
const start = { x: c + r * Math.cos(rad(210)), y: c - r * Math.sin(rad(210)) };
const end = { x: c + r * Math.cos(rad(-30)), y: c - r * Math.sin(rad(-30)) };
const path = `M ${start.x.toFixed(3)} ${start.y.toFixed(3)} A ${r} ${r} 0 1 1 ${end.x.toFixed(3)} ${end.y.toFixed(3)}`;
const length = (2 * Math.PI * r * 240) / 360;
const shown = Math.min(1, Math.max(0, fraction));
const offset = length * (1 - shown);
---

<svg width={size} height={size} viewBox={`0 0 ${size} ${size}`} class={className} aria-hidden="true" focusable="false">
  <path d={path} fill="none" stroke={track} stroke-width={stroke} stroke-linecap="round" />
  {shown > 0 && (
    <path
      d={path}
      fill="none"
      stroke={color}
      stroke-width={stroke}
      stroke-linecap="round"
      class="dial-arc"
      stroke-dasharray={length.toFixed(3)}
      stroke-dashoffset={animate ? length.toFixed(3) : offset.toFixed(3)}
      data-offset={animate ? offset.toFixed(3) : undefined}
    />
  )}
</svg>
