---
import Logo from './Logo.astro';
import LanguageMenu from './LanguageMenu.astro';
import ThemeMenu from './ThemeMenu.astro';
import { pathFor, useTranslations, type Locale } from '../i18n';
import { links } from '../data/links';
import { blogPath } from '../blog';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const home = pathFor(locale);
const nav = [
  [`${home}#why`, t('nav.why')],
  [`${home}#how`, t('nav.how')],
  [`${home}#providers`, t('nav.providers')],
  [`${home}#alerts`, t('nav.alerts')],
  [`${home}#security`, t('nav.security')],
  [blogPath(locale), t('nav.blog')]
];
---

<header class="sticky top-0 z-40 border-b border-ink-700/40 bg-ink-950/70 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5">
    <a href={pathFor(locale)} class="flex items-center gap-2.5 font-semibold tracking-tight text-slate-100" aria-label="Tokendial">
      <Logo size={28} />
      <span>Tokendial</span>
    </a>
    <nav aria-label="Primary" class="hidden items-center gap-1 lg:flex">
      {nav.map(([href, label]) => (
        <a href={href} class="whitespace-nowrap rounded-lg px-3 py-2 text-sm text-slate-400 transition-colors hover:bg-ink-800 hover:text-slate-100">{label}</a>
      ))}
    </nav>
    <div class="ms-auto flex items-center gap-2">
      <ThemeMenu locale={locale} />
      <LanguageMenu locale={locale} />
      <a href={links.releases} class="btn-primary !min-h-10 !px-4" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" /></svg>
        <span class="hidden sm:inline">{t('nav.download')}</span>
      </a>
    </div>
  </div>
</header>
