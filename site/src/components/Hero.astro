---
import DockDemo from './DockDemo.astro';
import { useTranslations, type Locale } from '../i18n';
import { links } from '../data/links';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="relative overflow-hidden pt-12 pb-10 md:pt-20 md:pb-12">
  <div class="mx-auto grid max-w-6xl items-center gap-14 px-5 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]">
    <div class="reveal is-visible">
      <span class="eyebrow">
        <span class="size-1.5 rounded-full bg-brand-400" aria-hidden="true"></span>
        {t('hero.eyebrow')}
      </span>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-slate-100 sm:text-5xl md:text-6xl md:leading-[1.05]">{t('hero.title')}</h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-400">{t('hero.lead')}</p>
      <div class="mt-8 flex flex-wrap gap-3" data-downloads>
        <a href={links.releases} class="btn-download" data-download="windows" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 5.5 10.5 4.4v7.1H3zm0 13L10.5 19.6v-7.1H3zM11.5 4.2 21 3v8.5h-9.5zm0 8.3H21V21l-9.5-1.2z" /></svg>
          {t('hero.windows')}
        </a>
        <a href={links.releases} class="btn-download" data-download="mac" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.9-.9-3.1-.8-1.6 0-3 .9-3.9 2.4-1.7 2.9-.4 7.2 1.2 9.5.8 1.2 1.8 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8 1.5 0 1.9.8 3.1.8 1.3 0 2.1-1.2 2.9-2.4.9-1.3 1.3-2.6 1.3-2.7 0 0-2.7-1-2.7-4zM14.2 5.6c.7-.8 1.1-1.9 1-3-1 0-2.1.7-2.8 1.5-.6.7-1.2 1.8-1 2.9 1.1.1 2.2-.6 2.8-1.4z" /></svg>
          {t('hero.macos')}
        </a>
        <a href={links.releases} class="btn-download" data-download="linux" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c-1.9 0-3 1.6-3 3.6 0 1.2.2 1.8-.4 2.9-.7 1.3-1.8 2.6-2.3 4.3-.3 1-.2 1.9.1 2.6-.5.6-.9 1.3-1.2 2-.2.5.1 1 .7 1.1.9.2 1.6.5 2.2 1 .5.4 1.2.3 1.6-.1.5.1 1.4.2 2.3.2s1.8-.1 2.3-.2c.4.4 1.1.5 1.6.1.6-.5 1.3-.8 2.2-1 .6-.1.9-.6.7-1.1-.3-.7-.7-1.4-1.2-2 .3-.7.4-1.6.1-2.6-.5-1.7-1.6-3-2.3-4.3-.6-1.1-.4-1.7-.4-2.9C15 3.6 13.9 2 12 2zm-1.4 3.1c.4 0 .7.4.7.9s-.3.9-.7.9-.7-.4-.7-.9.3-.9.7-.9zm2.8 0c.4 0 .7.4.7.9s-.3.9-.7.9-.7-.4-.7-.9.3-.9.7-.9zM12 8.2c.8 0 1.6.4 1.6.8 0 .3-.8.8-1.6.8s-1.6-.5-1.6-.8c0-.4.8-.8 1.6-.8z" /></svg>
          {t('hero.linux')}
        </a>
      </div>
      <p class="mt-4 text-xs text-slate-500">{t('hero.note')}</p>
      <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-2 font-mono text-xs">
        <div class="req req-windows"><dt class="sr-only">Windows</dt><dd>{t('platform.windows')}</dd></div>
        <div class="req req-mac"><dt class="sr-only">macOS</dt><dd>{t('platform.macos')}</dd></div>
        <div class="req req-linux"><dt class="sr-only">Linux</dt><dd>{t('platform.linux')}</dd></div>
      </dl>
    </div>
    <script is:inline>
      /* The reader's own platform leads. Moving the node keeps the tab order in step with what the eye
         sees, which reordering by CSS would not; the green is picked by CSS from data-platform, before
         first paint, so nothing flickers. */
      for (const row of document.querySelectorAll('[data-downloads]')) {
        const here = document.documentElement.dataset.platform;
        const want = here === 'mac' || here === 'linux' ? here : null;
        const lead = want && row.querySelector('[data-download="' + want + '"]');
        if (lead) row.prepend(lead);
      }
    </script>
    <figure class="reveal is-visible">
      <DockDemo locale={locale} />
      <figcaption class="mt-4 text-center text-xs text-slate-500">{t('demo.caption')}</figcaption>
    </figure>
  </div>
</section>
