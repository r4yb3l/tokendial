---
/** The hero's instrument. One 240° gauge that climbs on its own, changes band as it goes, and fires the
    product's own banner when it crosses 80 — the page doing what the app does instead of describing it.
    Static at its resting value when the reader asks for reduced motion, or before the script runs. */
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const size = 300;
const stroke = 16;
const c = size / 2;
const r = c - stroke / 2;
const rad = (deg: number) => (deg * Math.PI) / 180;
const start = { x: c + r * Math.cos(rad(210)), y: c - r * Math.sin(rad(210)) };
const end = { x: c + r * Math.cos(rad(-30)), y: c - r * Math.sin(rad(-30)) };
const path = `M ${start.x.toFixed(3)} ${start.y.toFixed(3)} A ${r} ${r} 0 1 1 ${end.x.toFixed(3)} ${end.y.toFixed(3)}`;
const length = (2 * Math.PI * r * 240) / 360;
const rest = 0.41;

const others = [
  { id: 'codex', pct: 12 },
  { id: 'copilot', pct: 63 },
  { id: 'cursor', pct: 87 },
  { id: 'gemini', pct: 4 }
] as const;
---

<div class="flex flex-col items-center" data-live-dial data-length={length.toFixed(3)}>
  <div class="relative" style={`width:${size}px;height:${size}px`}>
    <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`} aria-hidden="true" focusable="false">
      <path d={path} fill="none" stroke="var(--color-ink-700)" stroke-width={stroke} stroke-linecap="round" />
      <path
        d={path}
        fill="none"
        stroke="var(--color-brand-400)"
        stroke-width={stroke}
        stroke-linecap="round"
        data-arc
        stroke-dasharray={length.toFixed(3)}
        stroke-dashoffset={(length * (1 - rest)).toFixed(3)}
      />
    </svg>
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-0.5">
      <span class="font-mono text-6xl font-extrabold leading-none tracking-tighter text-brand-400 tabular-nums" data-pct>41%</span>
      <span class="text-sm font-semibold text-slate-100">{t('providers.claude')}</span>
      <span class="font-mono text-[11px] text-slate-400">{t('demo.window.5h')}</span>
    </div>
  </div>

  <ul class="mt-3 flex gap-2" role="list">
    {others.map((o) => (
      <li class="w-[74px] rounded-xl border border-ink-700/60 bg-ink-800 py-2 text-center">
        <span class="block font-mono text-sm font-bold" style={o.pct >= 80 ? 'color:var(--color-watch)' : 'color:var(--color-brand-400)'}>{o.pct}%</span>
        <span class="mt-0.5 block truncate px-1 text-[10px] text-slate-400">{t(`providers.${o.id}`)}</span>
      </li>
    ))}
  </ul>

  <div class="mt-4 h-[92px] w-full max-w-[360px]">
    <div class="card flex gap-3 p-4 opacity-0 transition-opacity duration-300" data-banner aria-live="polite">
      <span class="w-[3px] shrink-0 rounded-sm bg-watch" data-banner-bar aria-hidden="true"></span>
      <span>
        <span class="block text-sm font-semibold text-slate-100" data-banner-title>{t('alerts.1.fire')}</span>
        <span class="mt-0.5 block text-xs leading-relaxed text-slate-400">{t('alerts.1.body')}</span>
      </span>
    </div>
  </div>
</div>

<script is:inline>
  /* The climb only runs while the dial is on screen and only when motion is welcome; everywhere else the
     markup above already shows a truthful resting reading, so nothing depends on this script having run. */
  for (const root of document.querySelectorAll('[data-live-dial]')) {
    const arc = root.querySelector('[data-arc]');
    const out = root.querySelector('[data-pct]');
    const banner = root.querySelector('[data-banner]');
    const bar = root.querySelector('[data-banner-bar]');
    const length = Number(root.dataset.length);
    if (!arc || !out || !length) continue;

    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    let pct = 6;
    let timer = null;

    const band = (p) => (p >= 95 ? 'critical' : p >= 80 ? 'watch' : 'brand-400');

    const paint = (p) => {
      const colour = 'var(--color-' + band(p) + ')';
      arc.setAttribute('stroke-dashoffset', (length * (1 - p / 100)).toFixed(3));
      arc.setAttribute('stroke', colour);
      out.textContent = Math.round(p) + '%';
      out.style.color = colour;
      for (const word of document.querySelectorAll('[data-hero-accent]')) word.style.color = colour;
      if (banner && bar) {
        banner.style.opacity = p >= 80 ? '1' : '0';
        bar.style.background = colour;
      }
    };

    const tick = () => {
      pct = pct > 101 ? 6 : pct + 0.9;
      paint(pct);
    };

    const watcher = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting && !timer && !still.matches) timer = setInterval(tick, 70);
        else if (!entry.isIntersecting && timer) {
          clearInterval(timer);
          timer = null;
        }
      }
    }, { threshold: 0.3 });
    watcher.observe(root);
  }
</script>
