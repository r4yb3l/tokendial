---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dir, lang, locales, pathFor, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** The page's path for this locale; alternates are derived by swapping the locale prefix. Defaults to the landing. */
  path?: string;
  /** Absolute URL of the social image; the site's own card when absent. */
  image?: string;
}

const { locale, title, description, path, image } = Astro.props;
const t = useTranslations(locale);
const site = Astro.site ?? new URL('https://tokendial.app');
const pageTitle = title ?? t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonical = new URL(path ?? pathFor(locale), site).href;
const ogImage = image ?? new URL('/og.png', site).href;
---

<!doctype html>
<html lang={lang(locale)} dir={dir(locale)}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      const root = document.documentElement;
      try {
        const fromUrl = new URLSearchParams(location.search).get('theme');
        const stored = fromUrl || localStorage.getItem('theme');
        const chosen = stored === 'light' || stored === 'dark' ? stored : stored === 'system' ? null : 'dark';
        if (chosen) root.dataset.theme = chosen;
        else delete root.dataset.theme;
      } catch {
        root.dataset.theme = 'dark';
      }
      try {
        const ua = navigator.userAgent || '';
        const platform = navigator.userAgentData?.platform || navigator.platform || ua;
        const touch = /android|iphone|ipod/i.test(ua) || (/ipad/i.test(ua)) || (/mac/i.test(platform) && navigator.maxTouchPoints > 1);
        root.dataset.platform = touch ? 'mobile' : /mac/i.test(platform) ? 'mac' : /win/i.test(platform) ? 'windows' : 'other';
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0b0e14" />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    {!path && locales.map((code) => <link rel="alternate" hreflang={code} href={new URL(pathFor(code), site).href} />)}
    {!path && <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tokendial" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Tokendial',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Windows, macOS',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      license: 'https://opensource.org/licenses/MIT',
      url: site.href,
      description: t('meta.description')
    })} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-50 focus:rounded-lg focus:bg-brand-500 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-[#062b1f]">
      {t('nav.skip')}
    </a>
    <Header locale={locale} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let fired = false;
      const reveal = new IntersectionObserver(
        (entries) => {
          fired = true;
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-visible');
            for (const arc of entry.target.querySelectorAll<SVGElement>('[data-offset]')) {
              arc.style.strokeDashoffset = arc.dataset.offset ?? '0';
            }
            reveal.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.15 }
      );
      const showNow = (el: Element) => {
        el.classList.add('is-visible');
        for (const arc of el.querySelectorAll<SVGElement>('[data-offset]')) arc.style.strokeDashoffset = arc.dataset.offset ?? '0';
      };
      const staticReveal = reduce || document.visibilityState !== 'visible';
      for (const el of document.querySelectorAll('.reveal')) {
        if (staticReveal) showNow(el);
        else reveal.observe(el);
      }
      setTimeout(() => {
        if (fired) return;
        for (const el of document.querySelectorAll('.reveal:not(.is-visible)')) showNow(el);
      }, 1200);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') return;
        for (const el of document.querySelectorAll('.reveal:not(.is-visible)')) showNow(el);
      });
    </script>
  </body>
</html>
